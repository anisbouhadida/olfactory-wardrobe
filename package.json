{
  "name": "olfactory-wardrobe",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter web start",
    "dev:api": "pnpm --filter api start:dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
